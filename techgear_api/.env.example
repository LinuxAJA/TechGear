# ==========================================================
# TechGear API - variables de entorno
# ----------------------------------------------------------
# Copia este archivo como .env y completa los valores reales.
# El archivo .env esta en .gitignore y NUNCA debe subirse a Git.
# ==========================================================

# Cadena de conexion de MongoDB Atlas.
# Se obtiene en Atlas > Database > Connect > Drivers.
MONGODB_URL=mongodb+srv://<usuario>:<password>@<cluster>.mongodb.net/?appName=Cluster0

# Nombre de la base de datos (se crea sola la primera vez que se escribe).
MONGODB_DB=techgear_db

# Base de datos usada por la suite de pruebas de integracion.
MONGODB_TEST_DB=techgear_test

# Prefijo de la version de la API.
API_V1_PREFIX=/api/v1

# Origenes permitidos por CORS, separados por coma.
# El portal Django corre en el puerto 8000.
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Modo depuracion (True solo en desarrollo).
DEBUG=True
