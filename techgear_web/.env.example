# ==========================================================
# TechGear Web (portal Django) - variables de entorno
# ----------------------------------------------------------
# Copia este archivo como .env y completa los valores reales.
# El archivo .env esta en .gitignore y NUNCA debe subirse a Git.
# ==========================================================

# Clave criptografica de Django. En produccion debe ser larga y aleatoria.
# Se puede generar con:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=clave-solo-para-desarrollo-cambiala

# Modo depuracion. SIEMPRE False en produccion.
DJANGO_DEBUG=True

# Hosts autorizados, separados por coma.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# URL base de la API de FastAPI, incluyendo el prefijo de version.
#
# En desarrollo, con la API corriendo en local:
TECHGEAR_API_BASE_URL=http://localhost:8001/api/v1
#
# Contra la API desplegada en Render, usar la URL publica:
# TECHGEAR_API_BASE_URL=https://techgear-api.onrender.com/api/v1

# Segundos de espera maxima por cada peticion a la API.
# Nunca debe quedar vacio: sin timeout, si la API se cuelga, el portal tambien.
TECHGEAR_API_TIMEOUT=10

# Politica de reintentos ante fallos transitorios (502, 503, 504).
TECHGEAR_API_RETRIES=3
TECHGEAR_API_BACKOFF=0.3

# ── Apuntando a Render ────────────────────────────────────
# El plan gratuito duerme el servicio tras 15 minutos sin trafico y tarda cerca
# de un minuto en despertar. Con los valores de arriba la primera peticion
# fallaria. Al usar la URL de Render, cambiar a:
#
#   TECHGEAR_API_TIMEOUT=30
#   TECHGEAR_API_RETRIES=5
#   TECHGEAR_API_BACKOFF=2
#
# Con backoff=2 y 5 intentos se esperan 0, 2, 4, 8 y 16 segundos: 30 segundos
# acumulados, suficientes para cubrir el arranque en frio.
